# ---- AI (optional but recommended) ----------------------------------------
# Claude turns onboarding text into an interest profile, tags every clip, and
# periodically re-synthesizes the profile from watch history. Without it, axol
# falls back to keyword heuristics (it still works, just less nuanced).
ANTHROPIC_API_KEY=
# AXOL_MODEL=claude-opus-5-5
# AXOL_DISABLE_AI=1

# ---- Content discovery -----------------------------------------------------
# Free key from Google Cloud Console -> "YouTube Data API v3". The free quota
# covers ~100 searches/day, which is plenty for a pilot.
YOUTUBE_API_KEY=

# TikTok and Instagram have no public search API for third-party apps. Point
# this at any JSON endpoint you are licensed to use that answers
#   GET <url>?q=<query>&source=tiktok|instagram&limit=12  ->  [{ "url": "...", "title": "...", "creator": "..." }]
# AXOL_DISCOVERY_PROVIDER_URL=
# AXOL_DISCOVERY_PROVIDER_TOKEN=

# Optional: Facebook app token to enrich Instagram links with titles via oEmbed.
# IG_OEMBED_TOKEN=

# ---- Server -----------------------------------------------------------------
# PORT=3000
# AXOL_DB_PATH=./server/data/axol.sqlite
